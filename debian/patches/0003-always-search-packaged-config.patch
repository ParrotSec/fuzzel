Index: fuzzel/config.c
===================================================================
--- fuzzel.orig/config.c
+++ fuzzel/config.c
@@ -205,7 +205,7 @@ open_config(void)
 
     xdg_config_dirs_copy = xdg_config_dirs != NULL && xdg_config_dirs[0] != '\0'
         ? xstrdup(xdg_config_dirs)
-        : xstrdup("/etc/xdg:/usr/share/xdg");
+        : xstrdup("/etc/xdg");
 
     if (xdg_config_dirs_copy == NULL || xdg_config_dirs_copy[0] == '\0')
         goto done;
@@ -224,6 +224,16 @@ open_config(void)
         }
     }
 
+    /* Search the packaged default after every administrator configuration
+     * directory, including when XDG_CONFIG_DIRS is explicitly set. */
+    free(path);
+    path = xstrdup("/usr/share/xdg/fuzzel/fuzzel.ini");
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd >= 0) {
+        ret = (struct config_file){.path = path, .fd = fd};
+        path = NULL;
+    }
+
 done:
     free(xdg_config_dirs_copy);
     free(path);
Index: fuzzel/doc/fuzzel.1.scd
===================================================================
--- fuzzel.orig/doc/fuzzel.1.scd
+++ fuzzel/doc/fuzzel.1.scd
@@ -441,9 +441,9 @@ in this order:
 
 	- *XDG_CONFIG_HOME/fuzzel/fuzzel.ini* (defaulting to
 	  *~/.config/fuzzel/fuzzel.ini* if unset)
-	- *XDG_CONFIG_DIRS/fuzzel/fuzzel.ini* (defaulting to
-	  */etc/xdg/fuzzel/fuzzel.ini*, then
-	  */usr/share/xdg/fuzzel/fuzzel.ini*, if unset)
+	- each *XDG_CONFIG_DIRS/fuzzel/fuzzel.ini*, in order (defaulting to
+	  */etc/xdg/fuzzel/fuzzel.ini* if unset)
+	- */usr/share/xdg/fuzzel/fuzzel.ini*
 
 An example configuration file containing all options with their default value
 commented out will usually be installed to */usr/share/xdg/fuzzel/fuzzel.ini*.
